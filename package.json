{
  "name": "working-time",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:worker\" \"npm:dev:frontend\"",
    "dev:worker": "node scripts/ensure-dist.mjs && wrangler dev --port 8787",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply working-time-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply working-time-db --remote"
  },
  "dependencies": { "hono": "^4.7.4", "lucide-react": "^0.468.0", "react": "^18.3.1", "react-dom": "^18.3.1" },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1", "@tailwindcss/vite": "^4.0.14", "@types/react": "^18.3.18", "@types/react-dom": "^18.3.5", "@vitejs/plugin-react": "^4.3.4", "concurrently": "^9.1.2", "tailwindcss": "^4.0.14", "typescript": "~5.7.2", "vite": "^6.1.0", "wrangler": "^4.7.1"
  }
}
